# Copiar este archivo a .env y completar las claves. No versionar .env.

# Clave del proveedor compatible con OpenAI (OpenRouter según config/settings.py).
OPENAI_API_KEY=

# Clave de Tavily para la búsqueda web del clasificador de contexto y del investigador.
TAVILY_API_KEY=

# Token local obligatorio: la API lo exige en HTTP (Authorization: Bearer) y en el
# WebSocket. Genera uno con: python -c "import secrets; print(secrets.token_hex(32))"
# y pégalo también en la pantalla de inicio del cliente.
APP_TOKEN=

# OPENAI_API_BASE no se lee del entorno: config/settings.py fija https://openrouter.ai/api/v1

# Opcional: orígenes https exactos desde los que se abre el cliente web fuera de esta
# máquina, separados por comas (p. ej. el proxy de ZeroTier). Exige un APP_TOKEN de 32+ caracteres.
# ALLOWED_EXTRA_ORIGINS=https://10.147.17.5:8443
