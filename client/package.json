{
  "name": "sistema-estudio-multiagente",
  "version": "1.0.0",
  "private": true,
  "description": "Aplicación de escritorio para sesiones de estudio multiagente",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"npm:electron:dev\"",
    "electron:dev": "npm run build:electron && wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .",
    "build:electron": "tsc -p electron/tsconfig.json",
    "build": "npm run build:electron && vite build",
    "start": "electron .",
    "package:linux": "npm run build && electron-builder --linux AppImage deb",
    "typecheck": "tsc --noEmit && tsc -p electron/tsconfig.json --noEmit"
  },
  "dependencies": {
    "katex": "^0.19.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@types/node": "^22.15.30",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.6.0",
    "concurrently": "^9.2.0",
    "cross-env": "^7.0.3",
    "electron": "^44.7.2",
    "electron-builder": "27.0.0-alpha.10",
    "typescript": "~5.8.3",
    "vite": "^6.4.1",
    "wait-on": "^8.0.3"
  },
  "build": {
    "appId": "com.estudio.multiagente",
    "productName": "Estudio Multiagente",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "linux": {
      "category": "Education",
      "target": [
        "AppImage",
        "deb"
      ]
    }
  },
  "overrides": {
    "katex": "$katex"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
