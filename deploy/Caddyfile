# Proxy HTTPS de origen único para abrir el cliente desde otros dispositivos de la red ZeroTier.
# Variables: ZT_IP es la IP de esta PC en ZeroTier y REPO_DIR la carpeta del repositorio.
{
	# Sin API de administración ni puerto 80: solo escucha la dirección de abajo.
	admin off
	auto_https disable_redirects
}

https://{$ZT_IP}:8443 {
	# Solo la interfaz de ZeroTier; el backend sigue en 127.0.0.1:8000.
	bind {$ZT_IP}
	# Certificado de la CA local de Caddy; su raíz se instala una vez en cada dispositivo.
	tls internal

	# Sin directiva log a propósito: el log de accesos guardaría la cabecera
	# Sec-WebSocket-Protocol, donde viaja el token.

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		# Pyodide se carga desde cdn.jsdelivr.net y necesita WebAssembly y un worker.
		Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval' https://cdn.jsdelivr.net; worker-src 'self' blob:; connect-src 'self' https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
	}

	# API y WebSocket: se quita el prefijo /api antes de pasar la petición al backend.
	handle_path /api/* {
		# La aplicación limita los PDF a 20 MB.
		request_body {
			max_size 25MB
		}
		header Cache-Control no-store
		reverse_proxy 127.0.0.1:8000
	}

	# Cliente web compilado (npm run build en client/).
	handle {
		root * {$REPO_DIR}/client/dist
		@shell path / /index.html /sw.js /manifest.webmanifest
		header @shell Cache-Control no-cache
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		try_files {path} /index.html
		file_server
	}
}
