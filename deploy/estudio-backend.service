# Unidad systemd de usuario: backend en loopback. Copiar a ~/.config/systemd/user/
# y ajustar la ruta del repositorio si no está en ~/multi-agent-study-system.
[Unit]
Description=Estudio Multiagente: backend
After=network-online.target

[Service]
WorkingDirectory=%h/multi-agent-study-system
ExecStart=%h/multi-agent-study-system/.venv/bin/python -m uvicorn api.app:app --host 127.0.0.1 --port 8000 --ws-max-size 65536
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
